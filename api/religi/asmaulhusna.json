import express from 'express';
import axios from 'axios';

const router = express.Router();

const RAW_URL = "https://raw.githubusercontent.com/arulzzzxd/database/main/islam/asmaulhusna.json";

router.get('/', async (req, res) => {
  try {
    const response = await axios.get(RAW_URL, {
      headers: {
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'
      },
      timeout: 10000
    });

    const data = response.data;

    // Jika data dari JSON berupa array, kirimkan langsung sebagai respon JSON
    return res.status(200).json(data);

  } catch (err) {
    console.error("Asmaul Husna Route Error:", err.message);
    return res.status(500).json({
      status: false,
      creator: "Arulzxd",
      message: "Gagal mengambil data Asmaul Husna dari server database.",
      error: err.message
    });
  }
});

router.title = "Asmaul Husna";
router.desc = "Mengambil seluruh daftar 99 Asmaul Husna beserta teks Arab, Latin, dan terjemahannya.";
router.status = "ready";
router.type = "free";

export default router;
